# Copy to .env.local (not committed) and adjust if needed. All values are optional.

# Dev/preview server only: where `npm run dev` forwards /api/* (the backend has no CORS).
# Default: http://localhost:8080 (backend started with `mvn spring-boot:run`).
# Through the local Docker stack use the gateway instead: BACKEND_URL=http://localhost/api
BACKEND_URL=http://localhost:8080

# Built into the bundle: base path of the API seen by the browser. Default: /api
# (in production the Nginx gateway routes /api/* to the backend on the same domain).
VITE_API_BASE_URL=/api

# Google Analytics 4 measurement ID (optional: the site's own ID is built in; analytics runs only
# on the real site, never on localhost)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
